<template>
  <div class="tree-content-container">
    <!-- Refresh Button -->
    <div class="tree-header">
      <div class="header-info">
        <h2 class="tree-title">🌳 5-Tier Referral Network</h2>
        <p class="tree-subtitle">Track your multi-level referrals and accumulated points across 5 levels</p>
      </div>
      <div class="header-actions">
        <n-button @click="updateAllChains" :loading="isUpdatingChains" type="warning" size="large" style="margin-right: 10px;">
          <template #icon>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.2"/>
            </svg>
          </template>
          Update Chains
        </n-button>
        <n-button @click="refreshTree" :loading="isLoading" type="primary" size="large">
          <template #icon>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="23 4 23 10 17 10"/>
              <polyline points="1 20 1 14 7 14"/>
              <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>
            </svg>
          </template>
          Refresh
        </n-button>
      </div>
    </div>

    <!-- Points Overview Dashboard -->
    <div class="points-dashboard">
      <div class="points-card total-points-card">
        <div class="card-icon">🏆</div>
        <div class="card-content">
          <p class="card-label">Total Accumulated Points</p>
          <h2 class="card-value total-value">{{ referralTreeData.pointsBreakdown?.grandTotal?.toFixed(2) || '0.00' }}</h2>
          <p class="card-description">From all 5 levels combined</p>
        </div>
      </div>

      <div class="points-grid">
        <div class="points-card level-1-card clickable-card" @click="toggleLevel(1)" :class="{ expanded: expandedLevels[1] }">
          <div class="level-header">
            <span class="level-badge level-1-badge">LEVEL 1</span>
            <span class="level-percentage">25%</span>
          </div>
          <div class="level-stats">
            <h3 class="level-points">{{ referralTreeData.pointsBreakdown?.level1?.points?.toFixed(2) || '0.00' }}</h3>
            <p class="level-users">{{ referralTreeData.pointsBreakdown?.level1?.users || 0 }} direct referrals</p>
          </div>
          <div class="expand-icon">
            {{ expandedLevels[1] ? '▲' : '▼' }}
          </div>
        </div>

        <div class="points-card level-2-card clickable-card" @click="toggleLevel(2)" :class="{ expanded: expandedLevels[2] }">
          <div class="level-header">
            <span class="level-badge level-2-badge">LEVEL 2</span>
            <span class="level-percentage">15%</span>
          </div>
          <div class="level-stats">
            <h3 class="level-points">{{ referralTreeData.pointsBreakdown?.level2?.points?.toFixed(2) || '0.00' }}</h3>
            <p class="level-users">{{ referralTreeData.pointsBreakdown?.level2?.users || 0 }} 2nd tier users</p>
          </div>
          <div class="expand-icon">
            {{ expandedLevels[2] ? '▲' : '▼' }}
          </div>
        </div>

        <div class="points-card level-3-card clickable-card" @click="toggleLevel(3)" :class="{ expanded: expandedLevels[3] }">
          <div class="level-header">
            <span class="level-badge level-3-badge">LEVEL 3</span>
            <span class="level-percentage">10%</span>
          </div>
          <div class="level-stats">
            <h3 class="level-points">{{ referralTreeData.pointsBreakdown?.level3?.points?.toFixed(2) || '0.00' }}</h3>
            <p class="level-users">{{ referralTreeData.pointsBreakdown?.level3?.users || 0 }} 3rd tier users</p>
          </div>
          <div class="expand-icon">
            {{ expandedLevels[3] ? '▲' : '▼' }}
          </div>
        </div>

        <div class="points-card level-4-card clickable-card" @click="toggleLevel(4)" :class="{ expanded: expandedLevels[4] }">
          <div class="level-header">
            <span class="level-badge level-4-badge">LEVEL 4</span>
            <span class="level-percentage">5%</span>
          </div>
          <div class="level-stats">
            <h3 class="level-points">{{ referralTreeData.pointsBreakdown?.level4?.points?.toFixed(2) || '0.00' }}</h3>
            <p class="level-users">{{ referralTreeData.pointsBreakdown?.level4?.users || 0 }} 4th tier users</p>
          </div>
          <div class="expand-icon">
            {{ expandedLevels[4] ? '▲' : '▼' }}
          </div>
        </div>

        <div class="points-card level-5-card clickable-card" @click="toggleLevel(5)" :class="{ expanded: expandedLevels[5] }">
          <div class="level-header">
            <span class="level-badge level-5-badge">LEVEL 5</span>
            <span class="level-percentage">2%</span>
          </div>
          <div class="level-stats">
            <h3 class="level-points">{{ referralTreeData.pointsBreakdown?.level5?.points?.toFixed(2) || '0.00' }}</h3>
            <p class="level-users">{{ referralTreeData.pointsBreakdown?.level5?.users || 0 }} 5th tier users</p>
          </div>
          <div class="expand-icon">
            {{ expandedLevels[5] ? '▲' : '▼' }}
          </div>
        </div>
      </div>

      <!-- User Lists for Each Level (Expandable) -->
      <div v-for="level in [1, 2, 3, 4, 5]" :key="level" class="level-details" v-show="expandedLevels[level]">
        <div class="level-details-header">
          <h4>Level {{ level }} Users</h4>
          <span class="users-count">{{ getUsersAtLevel(level).length }} users</span>
        </div>
        <div class="users-list" v-if="getUsersAtLevel(level).length > 0">
          <div v-for="user in getUsersAtLevel(level)" :key="user.userID" class="user-item">
            <div class="user-avatar">
              <img v-if="user.profilePicture" :src="user.profilePicture" alt="avatar" />
              <div v-else class="avatar-placeholder">{{ user.username.charAt(0).toUpperCase() }}</div>
            </div>
            <div class="user-info">
              <p class="user-name">{{ user.username }}</p>
              <p class="user-code">Code: {{ user.referralCode }}</p>
              <p class="user-points">Activity: {{ user.activityPoints || 0 }} pts</p>
            </div>
            <div class="user-date">
              <p>Joined {{ formatDate(user.joinedAt) }}</p>
            </div>
          </div>
        </div>
        <div v-else class="empty-level">
          <p>No users at this level yet</p>
        </div>
      </div>
    </div>

    <!-- Tier Explanation -->
    <div class="tier-explanation">
      <div class="explanation-card">
        <h3 class="explanation-title">💡 How Multi-Level Rewards Work</h3>
        <div class="explanation-grid">
          <div class="explanation-item">
            <span class="explanation-icon">1️⃣</span>
            <div>
              <h4>Level 1 - Direct Referrals (25%)</h4>
              <p>You earn 25% of activity points from people you directly invite</p>
            </div>
          </div>
          <div class="explanation-item">
            <span class="explanation-icon">2️⃣</span>
            <div>
              <h4>Level 2 - Referrals of Referrals (15%)</h4>
              <p>Earn 15% from people invited by your Level 1 referrals</p>
            </div>
          </div>
          <div class="explanation-item">
            <span class="explanation-icon">3️⃣</span>
            <div>
              <h4>Level 3 - Third Tier (10%)</h4>
              <p>Get 10% from the third level in your network chain</p>
            </div>
          </div>
          <div class="explanation-item">
            <span class="explanation-icon">4️⃣</span>
            <div>
              <h4>Level 4 - Fourth Tier (5%)</h4>
              <p>Receive 5% from the fourth level down</p>
            </div>
          </div>
          <div class="explanation-item">
            <span class="explanation-icon">5️⃣</span>
            <div>
              <h4>Level 5 - Fifth Tier (2%)</h4>
              <p>Accumulate 2% from the deepest level in your network</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Empty State or Tree -->
    <div v-if="!referralTreeData.referralTree || referralTreeData.referralTree.length === 0" class="empty-tree-state">
      <div class="empty-tree-icon">🌱</div>
      <h3 class="empty-tree-title">Start Building Your 5-Tier Network</h3>
      <p class="empty-tree-description">
        Share your referral link to start earning points from up to 5 levels deep!<br>
        Example chain: You → Miruna (L1) → Ingrid (L2) → Alex (L3) → Adi (L4) → User (L5)
      </p>
    </div>

    <div v-else class="tree-info">
      <p class="tree-count">
        Total network size: <strong>{{ calculateTotalUsers() }}</strong> users across <strong>{{ calculateMaxDepth() }}</strong> levels
      </p>
    </div>
  </div>
</template>

<script setup>
import { ref, onMounted } from 'vue'
import { useCookie } from '#app'
import { useNotification } from 'naive-ui'

const notification = useNotification()

// User data
const userData = ref({
  userID: useCookie('userID').value,
  username: useCookie('username').value,
  referralCode: useCookie('referralCode').value
})

// Referral tree data
const referralTreeData = ref({
  referralTree: [],
  pointsBreakdown: {
    level1: { users: 0, points: 0 },
    level2: { users: 0, points: 0 },
    level3: { users: 0, points: 0 },
    level4: { users: 0, points: 0 },
    level5: { users: 0, points: 0 },
    grandTotal: 0
  }
})

const isLoading = ref(false)
const isUpdatingChains = ref(false)

// Expanded levels state
const expandedLevels = ref({
  1: false,
  2: false,
  3: false,
  4: false,
  5: false
})

// Toggle level expansion
const toggleLevel = (level) => {
  console.log(`🔄 Toggling level ${level}. Current state:`, expandedLevels.value[level])
  expandedLevels.value[level] = !expandedLevels.value[level]
  console.log(`✅ Level ${level} is now:`, expandedLevels.value[level] ? 'EXPANDED' : 'COLLAPSED')

  // Debug: Check what data we have
  const usersAtLevel = getUsersAtLevel(level)
  console.log(`📊 Users at level ${level}:`, usersAtLevel.length, usersAtLevel)
  console.log(`🌳 Full referralTree:`, referralTreeData.value.referralTree)
}

// Get users at a specific level
const getUsersAtLevel = (level) => {
  const users = []

  const collectUsersAtLevel = (nodes, currentLevel) => {
    if (!nodes || nodes.length === 0) {
      console.log(`⚠️  collectUsersAtLevel: No nodes at currentLevel ${currentLevel}`)
      return
    }

    for (const node of nodes) {
      console.log(`🔍 Checking node at level ${node.level}, looking for level ${level}:`, node.username)
      if (node.level === level) {
        users.push(node)
        console.log(`✅ Added user ${node.username} to level ${level}`)
      }

      if (node.children && node.children.length > 0) {
        collectUsersAtLevel(node.children, currentLevel + 1)
      }
    }
  }

  console.log(`🔎 getUsersAtLevel(${level}) called. Tree has ${referralTreeData.value.referralTree.length} top-level nodes`)
  collectUsersAtLevel(referralTreeData.value.referralTree, 1)
  console.log(`📋 Final users array for level ${level}:`, users.length, 'users')
  return users
}

// Format date helper
const formatDate = (dateString) => {
  if (!dateString) return 'Recently'
  const date = new Date(dateString)
  if (isNaN(date.getTime())) return 'Recently'
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric'
  })
}

// Fetch referral tree from API
const fetchReferralTree = async () => {
  isLoading.value = true
  try {
    console.log('🌳 Fetching 5-tier referral tree for user:', userData.value.userID)

    const response = await $fetch('/api/v1/calculateReferralTree', {
      query: { userID: userData.value.userID }
    })

    if (response.success) {
      referralTreeData.value.referralTree = response.data.referralTree || []
      referralTreeData.value.pointsBreakdown = response.data.pointsBreakdown || {
        level1: { users: 0, points: 0 },
        level2: { users: 0, points: 0 },
        level3: { users: 0, points: 0 },
        level4: { users: 0, points: 0 },
        level5: { users: 0, points: 0 },
        grandTotal: 0
      }

      console.log('✅ Referral tree loaded:', referralTreeData.value)

      notification.success({
        content: 'Tree Updated!',
        meta: `Loaded network with ${calculateTotalUsers()} total users`,
        duration: 3000
      })
    }
  } catch (error) {
    console.error('❌ Error fetching referral tree:', error)
    notification.error({
      content: 'Failed to Load Tree',
      meta: error.data?.statusMessage || 'Could not fetch referral tree data',
      duration: 3000
    })
  } finally {
    isLoading.value = false
  }
}

// Update all referral chains
const updateAllChains = async () => {
  isUpdatingChains.value = true
  try {
    console.log('🔄 Updating referral chains for all users...')

    const response = await $fetch('/api/v1/updateReferralChains', {
      method: 'POST'
    })

    if (response.success) {
      console.log('✅ Referral chains updated:', response)

      notification.success({
        content: 'Chains Updated!',
        meta: `Updated ${response.updatedUsers} users out of ${response.totalUsers} total`,
        duration: 3000
      })

      // Refresh the tree after updating chains
      await fetchReferralTree()
    }
  } catch (error) {
    console.error('❌ Error updating referral chains:', error)
    notification.error({
      content: 'Failed to Update Chains',
      meta: error.data?.statusMessage || 'Could not update referral chains',
      duration: 3000
    })
  } finally {
    isUpdatingChains.value = false
  }
}

// Refresh tree
const refreshTree = () => {
  fetchReferralTree()
}

// Calculate total users in tree
const calculateTotalUsers = () => {
  const breakdown = referralTreeData.value.pointsBreakdown
  return breakdown.level1.users + breakdown.level2.users + breakdown.level3.users + breakdown.level4.users + breakdown.level5.users
}

// Calculate max depth of tree
const calculateMaxDepth = () => {
  const breakdown = referralTreeData.value.pointsBreakdown
  if (breakdown.level5.users > 0) return 5
  if (breakdown.level4.users > 0) return 4
  if (breakdown.level3.users > 0) return 3
  if (breakdown.level2.users > 0) return 2
  if (breakdown.level1.users > 0) return 1
  return 0
}

// Load tree on mount
onMounted(() => {
  fetchReferralTree()
})
</script>

