# ============================================
# CRYPTO TRADING APP - ENVIRONMENT VARIABLES
# ============================================
#
# SECURITY WARNING:
# ----------------
# 1. NEVER commit the actual .env file to git
# 2. Generate strong, random secrets for production
# 3. Use different secrets for dev/staging/production
# 4. Rotate secrets periodically (every 90 days recommended)
# 5. Use environment variables in production (not .env files)
#
# Generate secure random secrets using:
# - Node.js: require('crypto').randomBytes(64).toString('hex')
# - OpenSSL: openssl rand -hex 64
# - Online: https://randomkeygen.com/ (use "CodeIgniter Encryption Keys")
#
# ============================================

# Environment
NODE_ENV=development  # Options: development, staging, production

# Server Configuration
PORT=3000
HOST=localhost

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/crypto-app-V1

# Security Secrets
# ⚠️  CRITICAL: Change these in production! ⚠️
# Generate with: require('crypto').randomBytes(64).toString('hex')
JWT_SECRET=change-this-to-a-secure-random-64-character-string-in-production-use-crypto-randomBytes
COOKIE_SECRET=change-this-to-a-different-secure-random-64-character-string-for-cookies

# API Keys - Exchange Integration
# ⚠️  NEVER commit real API keys! ⚠️
# Store these in secure environment variables or secrets manager
COINBASE_API_KEY=your-coinbase-api-key-here
COINBASE_API_SECRET=your-coinbase-api-secret-here

BINANCE_API_KEY=your-binance-api-key-here
BINANCE_API_SECRET=your-binance-api-secret-here

HYPERLIQUID_API_KEY=your-hyperliquid-api-key-here
HYPERLIQUID_API_SECRET=your-hyperliquid-api-secret-here

LCX_API_KEY=your-lcx-api-key-here
LCX_API_SECRET=your-lcx-api-secret-here

# Telegram API Configuration (for QR code authentication)
# ⚠️  Get these from https://my.telegram.org/apps ⚠️
# Required for Telegram user authentication with QR code scanning
TELEGRAM_API_ID=0  # Your Telegram App API ID (numeric)
TELEGRAM_API_HASH=  # Your Telegram App API Hash (32-character hex string)

# Session Configuration
SESSION_TIMEOUT=604800  # 7 days in seconds
SESSION_SECURE=false    # Set to true in production (requires HTTPS)

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_MAX=5        # Max auth requests per 15 minutes
RATE_LIMIT_TRADING_MAX=30    # Max trading requests per minute
RATE_LIMIT_API_MAX=100       # Max API requests per minute

# Logging
LOG_LEVEL=info  # Options: error, warn, info, debug
LOG_TO_FILE=false

# Feature Flags
ENABLE_CSRF_PROTECTION=true
ENABLE_RATE_LIMITING=true
ENABLE_API_KEY_ENCRYPTION=true

# Email Configuration (for notifications, password reset, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
EMAIL_FROM=noreply@your-domain.com

# ============================================
# PRODUCTION DEPLOYMENT CHECKLIST
# ============================================
#
# Before deploying to production, ensure:
#
# ✅ All secrets are changed from defaults
# ✅ JWT_SECRET is at least 64 characters, randomly generated
# ✅ COOKIE_SECRET is different from JWT_SECRET
# ✅ NODE_ENV is set to 'production'
# ✅ SESSION_SECURE is set to true
# ✅ Real exchange API keys are stored securely (not in .env)
# ✅ ALLOWED_ORIGINS is restricted to your production domain(s)
# ✅ HTTPS/SSL is enabled on your server
# ✅ Database has authentication enabled
# ✅ Firewall rules are configured
# ✅ Regular security updates are scheduled
#
# ============================================
