{
  "name": "crypto-trading-app",
  "version": "1.0.0",
  "description": "Advanced Multi-Exchange Crypto Trading Platform",
  "author": "SAVACAZAN",
  "private": true,
  "main": "windows-build/electron/main.js",
  "scripts": {
    "build": "nuxt build",
    "dev": "node --max-old-space-size=8192 node_modules/nuxt/bin/nuxt.mjs dev",
    "dev:normal": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "npm run build && electron-builder --config windows-build/electron-builder.json",
    "electron:build:win": "npm run build && electron-builder --win --x64 --config windows-build/electron-builder.json",
    "electron:build:msi": "npm run build && electron-builder --win msi --x64 --config windows-build/electron-builder.json",
    "electron:build:portable": "npm run build && electron-builder --win portable --x64 --config windows-build/electron-builder.json",
    "electron:build:all": "npm run build && electron-builder --win --x64 --config windows-build/electron-builder.json"
  },
  "devDependencies": {
    "@bg-dev/nuxt-naiveui": "^1.14.0",
    "@nuxt/devtools": "^1.3.9",
    "@types/node": "^18",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "nuxt": "^3.17.7",
    "pinia-plugin-persistedstate": "^4.7.1",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@cosmjs/amino": "^0.37.0",
    "@cosmjs/cosmwasm-stargate": "^0.37.0",
    "@cosmjs/crypto": "^0.37.0",
    "@cosmjs/encoding": "^0.37.0",
    "@cosmjs/proto-signing": "^0.37.0",
    "@cosmjs/stargate": "^0.37.0",
    "@css-render/vue3-ssr": "^0.15.14",
    "@debut/indicators": "^1.3.22",
    "@mtproto/core": "^6.3.0",
    "@pinia/nuxt": "^0.11.3",
    "@telegraf/session": "^2.0.0-beta.7",
    "@tensorflow/tfjs": "^4.22.0",
    "@vicons/ionicons5": "^0.12.0",
    "algosdk": "^2.11.0",
    "aptos": "^1.22.1",
    "axios": "^1.12.2",
    "bcrypt": "^5.1.1",
    "bip32": "^4.0.0",
    "bip39": "^3.1.0",
    "bs58": "^6.0.0",
    "ccxt": "^4.5.11",
    "chart.js": "^4.5.1",
    "crypto-js": "^4.2.0",
    "ethers": "^6.15.0",
    "jsonwebtoken": "^9.0.2",
    "lcx-sdk": "^1.0.0",
    "lightweight-charts": "^4.2.0",
    "lodash": "^4.17.21",
    "mathjs": "^11.12.0",
    "ml-random-forest": "^2.1.0",
    "moment": "^2.30.1",
    "node-telegram-bot-api": "^0.66.0",
    "nuxt-mongoose": "^1.0.6",
    "pinia": "^3.0.4",
    "protobufjs": "^7.5.4",
    "qrcode": "^1.5.4",
    "sass": "^1.93.2",
    "set-interval-async": "^3.0.3",
    "starknet": "^6.24.1",
    "technicalindicators": "^3.1.0",
    "telegraf": "^4.16.3",
    "tiny-secp256k1": "^2.2.3",
